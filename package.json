{
  "name": "open-analytics",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "everyapp dev",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "build": "pnpm run build:packages && tsx scripts/build-tracker-sdk.ts && vite build",
    "build:packages": "pnpm run build:package:ui && pnpm run build:package:product-ui",
    "build:package:ui": "pnpm --filter @insightflare/ui build",
    "build:package:product-ui": "pnpm --filter @insightflare/product-ui build",
    "typecheck:packages": "pnpm --filter @insightflare/ui typecheck && pnpm --filter @insightflare/product-ui typecheck",
    "check:packages": "pnpm run typecheck:packages && pnpm run build:packages",
    "build:tracker-sdk": "tsx scripts/build-tracker-sdk.ts",
    "lint": "eslint --cache --cache-location .cache/eslint --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location .cache/eslint --max-warnings 0 . --fix",
    "format": "prettier --cache --cache-location .cache/prettier --write \"**/*.{ts,tsx,js,jsx,css}\" --log-level warn",
    "format:check": "prettier --cache --cache-location .cache/prettier --check \"**/*.{ts,tsx,js,jsx,css}\" --log-level warn",
    "check:schema": "pnpm run generate:schema && git diff --exit-code docs/schema.sql src/lib/db/schema/generated.ts",
    "check:schema:fix": "pnpm run generate:schema",
    "check": "tsx scripts/check.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:ui-contracts": "tsx scripts/check-ui-contracts.ts",
    "check:layer": "tsx scripts/check-layer-contract.ts",
    "check:verify": "tsx scripts/check.ts --verify",
    "check:verbose": "tsx scripts/check.ts --verbose",
    "prepare": "tsx scripts/build-tracker-sdk.ts && husky",
    "typecheck": "pnpm run build:packages && cf workers types && tsc --noEmit -p tsconfig.json",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "watch:i18n": "tsx scripts/watch-i18n.ts",
    "test": "pnpm run build:packages && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reportsDirectory=coverage/core",
    "test:coverage:tracker": "vitest run --config vitest.tracker.config.ts --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reportsDirectory=coverage/tracker",
    "test:coverage:check": "pnpm run test:coverage -- --maxWorkers 16",
    "db:migrate:local": "everyapp db migrate",
    "dev:app": "tsx scripts/dev.ts",
    "deploy": "everyapp deploy"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/mapbox": "^9.3.10",
    "@every-app/sdk": "link:../private-every-app/packages/sdk",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/flagpack": "^1.2.7",
    "@iconify/react": "^6.0.2",
    "@insightflare/product-ui": "0.7.1",
    "@insightflare/ui": "0.7.1",
    "@number-flow/react": "^0.6.2",
    "@tanstack/highlight": "^1.0.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "asn-blocklist": "^1.20260823.0",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.12",
    "i18n-iso-countries": "^7.14.0",
    "isbot": "^5.2.2",
    "lucide-react": "^0.542.0",
    "maplibre-gl": "^6.11.2",
    "motion": "^12.43.0",
    "overlayscrollbars": "^2.16.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "recharts": "^2.15.4",
    "shadcn": "^3.8.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@cloudflare/workers-types": "5.20260917.1",
    "@eslint/js": "~9.39.5",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cf": "1.0.0-beta.14",
    "esbuild": "^0.28.1",
    "eslint": "~9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "everyapp": "link:../private-every-app/packages/cli",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "rlog-js": "^3.0.0",
    "tailwindcss": "^4.3.0",
    "terser": "^5.51.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.css": "prettier --write"
  }
}
